# Backend Environment Configuration Template
# Copy this file to .env in the backend directory and fill in your actual values
# NEVER commit the .env file to version control

# Database Configuration
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# JWT Security Configuration
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters_recommended

# Admin User Configuration (for development/testing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# Spring Profile Configuration
SPRING_PROFILES_ACTIVE=development

# Application Configuration (optional overrides)
# SERVER_PORT=8080
# LOGGING_LEVEL_ROOT=INFO
